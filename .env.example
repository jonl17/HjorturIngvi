# Placeholders only. Copy to .env.local and fill in after the Sanity project exists.
# Do not commit real values.

# Public. The dataset name is not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Unused at launch. Reserved for a later draft preview.
SANITY_API_READ_TOKEN=

# Server-only. Sanity GROQ webhook secret for POST /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Script only. Used by scripts/migrate-from-markdown.ts. The Next.js app never reads this.
SANITY_MIGRATION_WRITE_TOKEN=
